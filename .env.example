# =============================================================================
# Claude Token Tracker — configuration
#
# Every value below is optional; the defaults run a working single-user
# dashboard on http://localhost:5010 with no configuration at all.
# Full reference with defaults and trade-offs: docs/CONFIGURATION.md
# =============================================================================

# --- Core --------------------------------------------------------------------
PORT=5010
# Where Claude Code keeps its session logs. Override for a non-standard install.
CLAUDE_DIR=~/.claude
# Where the tracker keeps its own data. DB_PATH defaults to $DATA_DIR/tracker.db.
# DATA_DIR=./data
# DB_PATH=./data/tracker.db

# --- Backups -----------------------------------------------------------------
# Set BACKUP_PATH to enable periodic atomic snapshots (VACUUM INTO), pruned to
# the 10 most recent. A snapshot smaller than half the previous one is rejected.
BACKUP_PATH=
BACKUP_INTERVAL_HOURS=6

# --- Multi-user mode (hosted deployment) -------------------------------------
# With MULTI_USER=true every /api/* route requires a session cookie, data is
# isolated per user_id, the file watcher is off and data arrives via the sync
# agent instead. The three settings below are then REQUIRED.
MULTI_USER=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32 — also the key that encrypts stored Anthropic admin keys.
SESSION_SECRET=
BASE_URL=http://localhost:5010

# --- GitHub tab (optional) ---------------------------------------------------
# Single-user only: a personal access token with `repo` and `read:user`.
# In multi-user mode the per-user OAuth token is used and this is ignored.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_MINUTES=60

# --- Claude API tab (optional) -----------------------------------------------
# Anthropic Admin API key for organisation usage/cost. Can also be stored
# encrypted from the UI instead of being placed here.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_CACHE_TTL_MINUTES=60

# --- Share API (optional) ----------------------------------------------------
# 64-char hex. Enables the management endpoints used to publish per-project
# dashboards to external consumers. Generate in Settings or with
# `openssl rand -hex 32`.
SHARE_ADMIN_KEY=
